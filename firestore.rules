rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Menu items — public read, anyone can write (merchant tablet manages stock/prices)
    match /menuItems/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /drinks/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Orders — public read/write so merchant tablet can receive and update orders
    match /orders/{id} {
      allow create: if true;
      allow read:   if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Customer profiles
    match /customers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Subscribers
    match /subscribers/{id} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }

    // Staff roster — read: any signed-in user (staff portal looks up its own profile by email);
    // write: admin custom claim only (roster management is an admin-dashboard action)
    match /staff/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Staff sessions
    match /staffSessions/{id} {
      allow read, write: if request.auth != null;
    }

    // Add-ons (salads, sauces, extras) — public read so pickup app can fetch
    match /addOns/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
