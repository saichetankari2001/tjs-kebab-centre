rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Menu items + categories + drinks — public read, any auth write (admin ops)
    match /menuItems/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /drinks/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders — anyone can create (guest checkout), public read so merchant tablet
    // can receive orders without auth, auth required only to delete
    match /orders/{id} {
      allow create: if true;
      allow read:   if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Customer profiles — authenticated users can fully manage their own doc
    match /customers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Subscribers — anyone can opt-in (create), only auth users can read/delete
    match /subscribers/{id} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }

    // Staff sessions
    match /staffSessions/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
